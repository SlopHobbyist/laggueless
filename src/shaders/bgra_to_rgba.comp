#version 450

// BGRA -> RGBA channel swizzle for the LSFG source image.
//
// The host renderer's upload_image is VK_FORMAT_B8G8R8A8_UNORM (matches the
// libretro core's framebuffer). The LSFG src images are VK_FORMAT_R8G8B8A8_UNORM
// (what the LSFG SPIR-V shaders expect). vkCmdBlitImage between these formats
// copies bytes verbatim — it does NOT swizzle — which would leave the LSFG
// algorithm seeing red and blue swapped. That corrupts the luma-based motion
// estimate and produces visible shimmer/artifacts on motion edges.
//
// This shader samples the BGRA upload_image (via a uimage2D bound as
// VK_FORMAT_R8G8B8A8_UINT cast? No — simpler: sampled image with an image view
// that has identity components, and we explicitly swap on read).
//
// Dispatched as (ceil(W/8), ceil(H/8), 1).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input: upload image bound through an image view whose VkFormat is
// VK_FORMAT_B8G8R8A8_UNORM. The Vulkan ICD performs the byte-order conversion
// at the hardware sampler — imageLoad() returns .r=red, .g=green, .b=blue,
// .a=alpha regardless of the underlying memory order.
layout(set = 0, binding = 0, rgba8) uniform readonly image2D u_src;

// Output: RGBA LSFG source slot, view declared as VK_FORMAT_R8G8B8A8_UNORM.
// imageStore writes .r to red, .g to green, .b to blue, .a to alpha — again
// at the hardware sampler level, so the bytes land in the order R8G8B8A8 expects.
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_dst;

layout(push_constant) uniform Push {
    uint width;
    uint height;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (uint(p.x) >= pc.width || uint(p.y) >= pc.height) return;

    // No manual swap: with image views declared at the correct formats on both
    // sides, the GPU does the BGRA->RGBA byte reorder for us. The shader sees
    // semantically-correct .r/.g/.b/.a on both ends.
    imageStore(u_dst, p, imageLoad(u_src, p));
}
